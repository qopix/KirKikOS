{
  "build-tags": ["linux", "amd64"],
  "llvm-target": "x86_64-unknown-elf",
  "cpu": "x86-64",
  "features": "+cmov,+cx8,+fxsr,+mmx,+sse,+sse2,+x87",
  "goos": "linux",
  "goarch": "amd64",
  "gc": "none",
  "scheduler": "none",
  "linker": "ld.lld",
  "linker-flavor": "coff",
  "libc": "picolibc",
  "automatic-stack-size": false,
  "default-stack-size": 65536,
  "cflags": [
    "-Werror",
    "-fshort-enums",
    "-fomit-frame-pointer",
    "-fno-exceptions", "-fno-unwind-tables", "-fno-asynchronous-unwind-tables",
    "-ffunction-sections", "-fdata-sections",
    "-ffreestanding",
    "-fshort-wchar",
    "-mno-red-zone"
  ],
  "ldflags": [
    "--gc-sections",
    "--no-insert-timestamp"
  ],
  "extra-files": [
    "src/device/amd64/cpu_amd64.S",
    "src/runtime/asm_amd64.S"
  ]
}